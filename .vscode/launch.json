{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Next.js: Frontend",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev",
                "--",
                "--turbo" // Add Turbopack for faster builds
            ],
            "cwd": "${workspaceFolder}/src/frontend/app",
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/frontend/app/**", // More specific path
                "!**/node_modules/**"
            ],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "outFiles": [
                "${workspaceFolder}/src/frontend/app/.next/**/*.js" // Broader .next pattern
            ],
            "console": "integratedTerminal",
            "restart": true, // Enable automatic restart
            "env": {
                "NODE_ENV": "development",
                "NEXT_TELEMETRY_DISABLED": "1" // Disable Next.js telemetry
            }
        },
        {
            "name": "Next.js: Browser",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/src/frontend/app",
            "sourceMapPathOverrides": {
                "webpack://_N_E/*": "${webRoot}/*"
            }
        },
        {
            "name": "Python FastAPI",
            "type": "debugpy",
            "request": "launch",
            // Point to the Python executable in .venv/Scripts
            "module": "uvicorn",
            "args": [
                "app.main:app",
                //"--reload",
                "--env-file",
                ".env",
                "--log-level",
                "debug"
            ],
            "jinja": true,
            "cwd": "${workspaceFolder}/src/api"
        }
    ],
    "compounds": [
        {
            "name": "Next.JS Frontend & Python FastAPI",
            "configurations": [
                "Next.js: Frontend",
                "Python FastAPI"
            ]
        },
        {
            "name": "Full Stack (Server + Browser + API)",
            "configurations": [
                "Next.js: Frontend",
                "Next.js: Browser",
                "Python FastAPI"
            ]
        }
    ]
}